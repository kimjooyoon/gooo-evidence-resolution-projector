{
  "language": "gooo",
  "language_version": "0.1",
  "graph": {
    "id": "gooo-evidence-resolution-projector",
    "release": "v0.1.0",
    "projection": {
      "schema_version": "1.0.0",
      "decision_order": ["REFUTED", "UNKNOWN", "CLOSED"],
      "semantic_rules": {
        "refuted_state": "REFUTED",
        "unknown_state": "UNKNOWN",
        "closed_state": "CLOSED",
        "external_utility_zero_evidence_state": "UNKNOWN"
      },
      "fields": [
        {"id": "case_id", "label": "Case ID", "source": "id", "invariant": true, "allowed_omission": []},
        {"id": "title", "label": "Title", "source": "title", "invariant": true, "allowed_omission": []},
        {"id": "summary", "label": "Loss-declared summary", "source": "summary", "invariant": true, "allowed_omission": []},
        {"id": "summary_refs", "label": "Summary stable references", "source": "summary_refs", "invariant": true, "allowed_omission": []},
        {"id": "decision", "label": "Decision", "source": "decision", "invariant": true, "allowed_omission": []},
        {"id": "decision_digest", "label": "Decision digest", "source": "decision_digest", "invariant": true, "allowed_omission": []},
        {"id": "claim_state", "label": "Claim state", "source": "claim_states", "invariant": true, "allowed_omission": []},
        {"id": "proof_choice", "label": "Proof choice", "source": "proof_choices", "invariant": true, "allowed_omission": []},
        {"id": "evidence_ids", "label": "Evidence IDs", "source": "evidence_ids", "invariant": true, "allowed_omission": []},
        {"id": "evidence_descriptions", "label": "Evidence descriptions", "source": "evidence_descriptions", "invariant": true, "allowed_omission": []},
        {"id": "counterexample_ids", "label": "REFUTED counterexample IDs", "source": "counterexample_ids", "invariant": true, "allowed_omission": []},
        {"id": "counterexample_descriptions", "label": "REFUTED counterexamples", "source": "counterexample_descriptions", "invariant": true, "allowed_omission": []},
        {"id": "unknown.stage", "label": "UNKNOWN stage", "source": "unknown_frontier.stage", "invariant": true, "allowed_omission": []},
        {"id": "unknown.step", "label": "UNKNOWN step", "source": "unknown_frontier.step", "invariant": true, "allowed_omission": []},
        {"id": "unknown.reason", "label": "UNKNOWN reason", "source": "unknown_frontier.reason", "invariant": true, "allowed_omission": []},
        {"id": "unknown.unknown_class", "label": "UNKNOWN class", "source": "unknown_frontier.unknown_class", "invariant": true, "allowed_omission": []},
        {"id": "unknown.next_operation", "label": "UNKNOWN next operation", "source": "unknown_frontier.next_operation", "invariant": true, "allowed_omission": []},
        {"id": "unknown.blocked_by", "label": "UNKNOWN blocked by", "source": "unknown_frontier.blocked_by", "invariant": true, "allowed_omission": []},
        {"id": "source_context", "label": "Source context", "source": "source_context", "invariant": false, "allowed_omission": ["user", "operator"]},
        {"id": "operator_notes", "label": "Operator notes", "source": "operator_notes", "invariant": false, "allowed_omission": ["user"]},
        {"id": "audit_trace", "label": "Audit trace", "source": "audit_trace", "invariant": false, "allowed_omission": ["user", "operator"]}
      ],
      "groups": [
        {"id": "unknown_causal_frontier", "field_ids": ["unknown.stage", "unknown.step", "unknown.reason", "unknown.unknown_class", "unknown.next_operation", "unknown.blocked_by"], "exact_count": 6}
      ],
      "views": [
        {"id": "user", "label": "User", "omits": ["source_context", "operator_notes", "audit_trace"]},
        {"id": "operator", "label": "Operator", "omits": ["source_context", "audit_trace"]},
        {"id": "auditor", "label": "Auditor", "omits": []}
      ]
    },
    "activities": [
      {"id": "activity.collect-invoice", "name": "Collect invoice evidence", "binding": {"case_id": "case-closed-1"}},
      {"id": "activity.reconcile-ledger", "name": "Reconcile ledger evidence", "binding": {"case_id": "case-closed-2"}},
      {"id": "activity.verify-signature", "name": "Verify signature evidence", "binding": {"case_id": "case-closed-3"}},
      {"id": "activity.trace-export", "name": "Trace export lineage", "binding": {"case_id": "case-unknown-1"}},
      {"id": "activity.query-external", "name": "Query external utility", "binding": {"case_id": "case-unknown-2"}},
      {"id": "activity.await-owner", "name": "Await owner confirmation", "binding": {"case_id": "case-unknown-3"}},
      {"id": "activity.counterexample-invoice", "name": "Check invoice counterexample", "binding": {"case_id": "case-refuted-1"}},
      {"id": "activity.counterexample-policy", "name": "Check policy counterexample", "binding": {"case_id": "case-refuted-2"}},
      {"id": "activity.counterexample-mixed", "name": "Check mixed-state counterexample", "binding": {"case_id": "case-refuted-3"}}
    ],
    "evidence": [
      {"id": "evidence-closed-1-ledger", "kind": "signed_record", "description": "Signed invoice ledger confirms the amount and owner.", "source_ref": "ledger://invoice/001"},
      {"id": "evidence-closed-2-reconcile", "kind": "reconciliation", "description": "Two independent ledger entries reconcile to the same total.", "source_ref": "ledger://reconcile/002"},
      {"id": "evidence-closed-3-signature", "kind": "signature", "description": "The approved signer matches the recorded authorization.", "source_ref": "auth://signature/003"},
      {"id": "evidence-unknown-1-observation", "kind": "observation", "description": "An export was observed, but its upstream lineage is not present.", "source_ref": "export://observed/004"},
      {"id": "evidence-unknown-2-request", "kind": "request", "description": "An external lookup was requested without a returned evidence record.", "source_ref": "utility://request/005"},
      {"id": "evidence-unknown-3-owner", "kind": "observation", "description": "The owner has not yet confirmed the causal handoff.", "source_ref": "handoff://pending/006"},
      {"id": "evidence-refuted-1-counterexample", "kind": "counterexample", "description": "A duplicate invoice has a conflicting amount.", "source_ref": "ledger://invoice/007"},
      {"id": "evidence-refuted-2-counterexample", "kind": "counterexample", "description": "The policy record contradicts the asserted approval window.", "source_ref": "policy://window/008"},
      {"id": "evidence-refuted-3-counterexample", "kind": "counterexample", "description": "A source event predates the claimed authorizing event.", "source_ref": "event://ordering/009"}
    ],
    "cases": [
